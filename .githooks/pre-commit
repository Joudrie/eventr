#!/bin/sh
# Eventr pre-commit gate. See BUILD-PLAN.md §5.
# Bypass with `git commit --no-verify` only when you have a specific reason.
set -e

if [ ! -d node_modules ]; then
  echo "pre-commit: node_modules missing, skipping checks"
  exit 0
fi

echo "pre-commit: typecheck"
npm run --silent typecheck

echo "pre-commit: lint"
npm run --silent lint

echo "pre-commit: format"
npm run --silent format:check
